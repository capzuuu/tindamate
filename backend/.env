# MySQL Database Connection Settings
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tindamate_db

# Full Database URL (If provided, overrides individual settings above)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/tindamate_db

# Fallback to local SQLite if MySQL is unreachable (true/false)
# Useful for instant testing or when MySQL service is temporarily offline
DB_FALLBACK_SQLITE=true

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
