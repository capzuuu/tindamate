# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tindamate_db

# Full Database URL
DATABASE_URL=mysql+pymysql://root:@localhost:3306/tindamate_db

# Fallback to local SQLite if MySQL is unreachable during development
DB_FALLBACK_SQLITE=true

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
